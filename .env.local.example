# Site
SITE_URL=http://localhost:3000

# Video
VIDEO_MODE=embed
VIDEO_EMBED_URL=https://www.youtube.com/embed/YOUR_VIDEO_ID
VIDEO_MP4_URL=
VIDEO_POSTER_URL=

# Contact Form
CONTACT_EMAIL_TO=hello@spaarke.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
STORAGE_ACCOUNT_CONNECTION=
RATE_LIMIT_PER_MINUTE=5

# Microsoft Bookings page embedded on /meet (the public booking page URL,
# https://bookings.cloud.microsoft/book/...). Without it, /meet points to /contact.
BOOKINGS_PAGE_URL=

# Graph booking flow on /meet (docs/meet-graph-booking.md). MEET_BOOKING_MODE=graph
# switches it on; until then /meet shows the Bookings embed above.
# MEET_DEV_MOCK=1 runs the flow against an in-memory calendar under `next dev`.
MEET_BOOKING_MODE=
MEET_GRAPH_TENANT_ID=
MEET_GRAPH_CLIENT_ID=
MEET_GRAPH_CLIENT_SECRET=
MEET_HOST=
MEET_LINK_SECRET=
MEET_HOST_TIME_ZONE=America/New_York
MEET_DEV_MOCK=

# reCAPTCHA (v2 invisible)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Self-Service Registration (BFF API proxy)
BFF_API_URL=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Clarity project ID (register at clarity.microsoft.com,
# then set this to the project ID, e.g. "abc123xyz"). Without it,
# Clarity is skipped (dev/preview).
NEXT_PUBLIC_CLARITY_PROJECT_ID=
