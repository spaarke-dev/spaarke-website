# Site
SITE_URL=http://localhost:3000

# Video
VIDEO_MODE=embed
VIDEO_EMBED_URL=https://www.youtube.com/embed/YOUR_VIDEO_ID
VIDEO_MP4_URL=
VIDEO_POSTER_URL=

# Contact Form
CONTACT_EMAIL_TO=hello@spaarke.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
STORAGE_ACCOUNT_CONNECTION=
RATE_LIMIT_PER_MINUTE=5

# Microsoft Bookings page embedded on /meet (the public booking page URL,
# https://bookings.cloud.microsoft/book/...). Without it, /meet points to /contact.
BOOKINGS_PAGE_URL=

# Graph booking flow on /meet (docs/meet-graph-booking.md). MEET_BOOKING_MODE=graph
# switches it on; until then /meet shows the Bookings embed above.
# MEET_DEV_MOCK=1 runs the flow against an in-memory calendar under `next dev`.
MEET_BOOKING_MODE=
MEET_GRAPH_TENANT_ID=
MEET_GRAPH_CLIENT_ID=
MEET_GRAPH_CLIENT_SECRET=
MEET_HOST=
MEET_LINK_SECRET=
MEET_HOST_TIME_ZONE=America/New_York
MEET_DEV_MOCK=
# Bearer secret for /api/meet/reminders, which the reminder Logic App calls
# every five minutes. At least 32 characters; the route is off without it.
MEET_CRON_SECRET=
# Sign-off on the meeting emails. Kept out of the code because the repo is public.
MEET_SIGNATURE_NAME=
MEET_SIGNATURE_PHONE=

# Text MEET (docs/text-to-meet.md). SMS_MODE=twilio switches it on; unset,
# /api/sms/inbound answers 404 and /meet shows no "Prefer to text?" line.
# Secrets come from Key Vault; for local use any 32+ characters will do.
SMS_MODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only while rotating the auth token.
TWILIO_AUTH_TOKEN_PREVIOUS=
# The exact URL set in Twilio (it signs this URL). http is allowed only for localhost.
SMS_WEBHOOK_URL=http://localhost:3000/api/sms/inbound
# The toll-free number, any common format. Not committed: the repo is public.
SMS_PUBLIC_NUMBER=
SMS_LINK_SECRET=
# Never rotated in production: it keys every sender row.
SMS_PHONE_HASH_SECRET=
SMS_REPLY_HOURLY_CAP=30
SMS_REPLY_DAILY_CAP=150
# Table names, for local checks against Azurite only (npm run sms:check -- --server).
# Leave unset in Azure: the defaults are SmsSenders, SmsConversations, SmsInbound, SmsCounters.
SMS_SENDERS_TABLE=
SMS_CONVERSATIONS_TABLE=
SMS_INBOUND_TABLE=
SMS_COUNTERS_TABLE=

# reCAPTCHA (v2 invisible)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Self-Service Registration (BFF API proxy)
BFF_API_URL=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Microsoft Clarity project ID (register at clarity.microsoft.com,
# then set this to the project ID, e.g. "abc123xyz"). Without it,
# Clarity is skipped (dev/preview).
NEXT_PUBLIC_CLARITY_PROJECT_ID=
